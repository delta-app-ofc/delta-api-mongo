SERVER_PORT=8081
MONGODB_TELEMETRY_URI=mongodb+srv://<usuario>:<senha>@<cluster-telemetria>/?retryWrites=true&w=majority
MONGODB_TELEMETRY_DATABASE=db_delta_telemetry

# Cluster da aplicação: configurar antes de habilitar detector ou API de alertas.
MONGODB_APP_URI=mongodb+srv://<usuario>:<senha>@<cluster-app>/?retryWrites=true&w=majority
MONGODB_APP_DATABASE=db_delta_app

DELTA_DETECTION_ENABLED=false
DELTA_DETECTION_CONFIG_VERSION=1
DELTA_DETECTION_OWNER_URL=http://localhost:8080
# Usar a mesma AUTH_SERVICE_KEY configurada na API Postgres.
DELTA_DETECTION_OWNER_SERVICE_KEY=substitua-pela-chave-de-servico-do-postgres

DELTA_ALERTS_ENABLED=false
# Chave compartilhada apenas entre API Mongo e os serviços autorizados a escrever alertas.
ALERTS_SERVICE_KEY=substitua-por-uma-chave-local
# Caminho para a chave pública RSA do back-end; também aceita PEM inline.
AUTH_PUBLIC_KEY=./keys/public.pem
AUTH_ISSUER=delta-api
AUTH_AUDIENCE=delta-api

DELTA_ALLOWED_ORIGINS=http://localhost:5173
